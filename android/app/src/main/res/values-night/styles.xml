<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Keep the launch frame consistent even when the device uses night mode. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/routina_ember</item>
        <item name="android:navigationBarColor">@color/routina_ember</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/routina_cream</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
